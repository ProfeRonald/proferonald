{
  "name": "proferonald",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-proferonald --only database,storage \"node --test tests/rules/*.test.mjs\"",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build",
    "admin": "node scripts/admin.mjs",
    "seo": "node scripts/seo.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "dompurify": "3.4.17",
    "firebase": "13.2.0",
    "mathlive": "0.111.4"
  },
  "overrides": { "@grpc/grpc-js": "1.14.7" },
  "devDependencies": {
    "@google-cloud/storage": "8.4.0",
    "google-auth-library": "11.3.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "jsdom": "30.1.3",
    "sharp": "0.35.5"
  }
}
